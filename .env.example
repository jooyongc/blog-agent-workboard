# ASTY Blog Agent — Lean Edition env
# Monthly budget: <$10 (expected: $3-$5)
# NEVER commit .env to git.

# --- Anthropic ---
# Default model: claude-haiku-4-5 (hardcoded in agents)
# Set a spend limit at: https://console.anthropic.com/settings/limits
ANTHROPIC_API_KEY=sk-ant-...

# --- DeepL (Free tier — 500k chars/month) ---
DEEPL_API_KEY=...:fx

# Run `npx tsx scripts/setup-glossaries.ts` once to generate these
DEEPL_GLOSSARY_JA_ID=
DEEPL_GLOSSARY_ZH_ID=

# DeepL cost guards
DEEPL_MAX_CHARS_PER_RUN=40000
DEEPL_MAX_CHARS_MONTHLY=450000

# --- Unsplash (Free tier) ---
UNSPLASH_ACCESS_KEY=

# --- ASTY Cabin site ---
ASTY_SITE_URL=https://asty-cabin-check.vercel.app
ASTY_AGENT_API_KEY=

# --- Bridge: keep credentials in the existing server-only file ---
BRIDGE_CREDENTIALS_FILE=/Users/project.adv/@Github/jooyongc/koreabylocal/.env.local
BRIDGE_SUPABASE_URL=https://agkkvtfwqmzgbrqhvohs.supabase.co
# Read by bridge from the credentials file; never use a VITE_ service-role key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional manual Blogger draft API (aside browser remains schedule owner)
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_ACCESS_TOKEN=
# Paid translation fallback is disabled until explicitly enabled
ALLOW_LLM_TRANSLATION_FALLBACK=false
